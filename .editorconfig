root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,json,css,scss,html,vue,svelte}]
indent_size = 2

[*.{yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.go]
indent_style = tab

[*.{sh,bash,zsh}]
indent_size = 4

[{package.json,.travis.yml,.prettierrc}]
indent_size = 2
