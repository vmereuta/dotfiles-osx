# ──────────────────────────────────────────────────────────────
# Editors
# ──────────────────────────────────────────────────────────────

export EDITOR="nvim"
export VISUAL="code --wait"
export SUDO_EDITOR="nvim"

# ──────────────────────────────────────────────────────────────
# Language & Locale
# ──────────────────────────────────────────────────────────────

export LANG='en_GB.UTF-8'
export LC_ALL='en_GB.UTF-8'

# ──────────────────────────────────────────────────────────────
# History (shared with .zshrc but also used by other tools)
# ──────────────────────────────────────────────────────────────

export HISTSIZE=50000
export SAVEHIST=50000

# ──────────────────────────────────────────────────────────────
# Pager & Man
# ──────────────────────────────────────────────────────────────

# Use bat as man pager if available
if command -v bat &>/dev/null; then
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT="-c"
fi

export PAGER="less"
export LESS="-R --mouse --wheel-lines=3"

# ──────────────────────────────────────────────────────────────
# Python / uv
# ──────────────────────────────────────────────────────────────

export PYTHONIOENCODING='UTF-8'
export PYTHONDONTWRITEBYTECODE=1
export UV_LINK_MODE=copy

# ──────────────────────────────────────────────────────────────
# Node
# ──────────────────────────────────────────────────────────────

export NODE_REPL_HISTORY=~/.node_history
export NODE_REPL_HISTORY_SIZE='32768'
export NODE_REPL_MODE='sloppy'

# ──────────────────────────────────────────────────────────────
# fzf
# ──────────────────────────────────────────────────────────────

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# Claude-themed fzf colors (warm terracotta palette)
export FZF_DEFAULT_OPTS="
  --height=60%
  --layout=reverse
  --border=rounded
  --prompt='  '
  --pointer='▶'
  --marker='✓'
  --color=bg+:#2d2620,bg:#1a1714,spinner:#D97757,hl:#D97757
  --color=fg:#c4b5a0,header:#D97757,info:#a08060,pointer:#D97757
  --color=marker:#D97757,fg+:#e8ddd0,prompt:#D97757,hl+:#e8a070
  --bind='ctrl-/:toggle-preview'
  --preview-window='right:60%:wrap'
"

# fzf preview commands
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:500 {} 2>/dev/null || eza --icons --color=always {}'"
export FZF_ALT_C_OPTS="--preview 'eza --icons --color=always --tree --level=2 {}'"

# ──────────────────────────────────────────────────────────────
# Obsidian
# ──────────────────────────────────────────────────────────────

# Set your vault path
export OBSIDIAN_VAULT="${HOME}/Library/Mobile Documents/iCloud~md~obsidian/Documents/arini"

# ──────────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────────

# Homebrew
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1

# GPG
export GPG_TTY=$(tty)
