# ──────────────────────────────────────────────────────────────
# General utilities
# ──────────────────────────────────────────────────────────────

# Create a new directory and enter it
function mkd() {
    mkdir -p "$@" && cd "$_"
}

# Determine size of a file or total size of a directory
function fs() {
    if du -b /dev/null > /dev/null 2>&1; then
        local arg=-sbh
    else
        local arg=-sh
    fi
    if [[ -n "$@" ]]; then
        du $arg -- "$@"
    else
        du $arg .[^.]* .* *
    fi
}

# Create a .tar.gz archive, using best available compression
function targz() {
    local tmpFile="${@%/}.tar"
    tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1

    local size=$(stat -f"%z" "${tmpFile}" 2>/dev/null || stat -c"%s" "${tmpFile}" 2>/dev/null)
    local cmd="gzip"
    if (( size < 52428800 )) && command -v zopfli &>/dev/null; then
        cmd="zopfli"
    elif command -v pigz &>/dev/null; then
        cmd="pigz"
    fi

    echo "Compressing .tar using \`${cmd}\`..."
    "${cmd}" -v "${tmpFile}" || return 1
    [ -f "${tmpFile}" ] && rm "${tmpFile}"
    echo "${tmpFile}.gz created successfully."
}

# Compare original and gzipped file size
function gz() {
    local origsize=$(wc -c < "$1")
    local gzipsize=$(gzip -c "$1" | wc -c)
    local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l)
    printf "orig: %d bytes\n" "$origsize"
    printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio"
}

# Simple calculator
function calc() {
    local result=""
    result="$(printf "scale=10;$*\n" | bc --mathlib | tr -d '\\\n')"
    if [[ "$result" == *.* ]]; then
        printf "$result" |
        sed -e 's/^\./0./' \
            -e 's/^-\./-0./' \
            -e 's/0*$//;s/\.$//'
    else
        printf "$result"
    fi
    printf "\n"
}

# Use Git's colored diff when available
if command -v git &>/dev/null; then
    function diff() {
        git diff --no-index --color-words "$@"
    }
fi

# ──────────────────────────────────────────────────────────────
# Data & encoding
# ──────────────────────────────────────────────────────────────

# Create a data URL from a file
function dataurl() {
    local mimeType=$(file -b --mime-type "$1")
    if [[ $mimeType == text/* ]]; then
        mimeType="${mimeType};charset=utf-8"
    fi
    echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')"
}

# Syntax-highlight JSON (using jq + bat)
function json() {
    if [ -t 0 ]; then
        echo "$*" | jq . | bat -l json --paging=never
    else
        jq . | bat -l json --paging=never
    fi
}

# UTF-8-encode a string of Unicode symbols
function escape() {
    printf "\\\x%s" $(printf "$@" | xxd -p -c1 -u)
    if [ -t 1 ]; then
        echo ""
    fi
}

# ──────────────────────────────────────────────────────────────
# Network
# ──────────────────────────────────────────────────────────────

# Enhanced dig
function digga() {
    dig +nocmd "$1" any +multiline +noall +answer
}

# Show SSL certificate details for a domain
function getcertnames() {
    if [ -z "${1}" ]; then
        echo "ERROR: No domain specified."
        return 1
    fi

    local domain="${1}"
    echo "Testing ${domain}..."

    local tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
        | openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1)

    if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
        local certText=$(echo "${tmp}" \
            | openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
            no_serial, no_sigdump, no_signame, no_validity, no_version")
        echo "Common Name:"
        echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//"
        echo ""
        echo "Subject Alternative Name(s):"
        echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
            | sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2
    else
        echo "ERROR: Certificate not found."
        return 1
    fi
}

# Start a simple HTTP server from current directory
function serve() {
    local port="${1:-8000}"
    echo "Serving on http://localhost:${port}"
    python3 -m http.server "$port"
}

# ──────────────────────────────────────────────────────────────
# File operations
# ──────────────────────────────────────────────────────────────

# Extract any archive
function extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2) tar xjf "$1" ;;
            *.tar.gz)  tar xzf "$1" ;;
            *.tar.xz)  tar xJf "$1" ;;
            *.bz2)     bunzip2 "$1" ;;
            *.rar)     unrar e "$1" ;;
            *.gz)      gunzip "$1" ;;
            *.tar)     tar xf "$1" ;;
            *.tbz2)    tar xjf "$1" ;;
            *.tgz)     tar xzf "$1" ;;
            *.zip)     unzip "$1" ;;
            *.Z)       uncompress "$1" ;;
            *.7z)      7z x "$1" ;;
            *)         echo "'$1' cannot be extracted" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# `tre` - tree with sensible defaults
function tre() {
    eza --tree --icons --group-directories-first -I '.git|node_modules|.venv|__pycache__' "$@" 2>/dev/null \
        || tree -aC -I '.git|node_modules|.venv|__pycache__' --dirsfirst "$@" | less -FRNX
}

# ──────────────────────────────────────────────────────────────
# fzf-powered functions
# ──────────────────────────────────────────────────────────────

# fzf file opener - find and open files in editor
function fe() {
    local file
    file=$(fd --type f --hidden --follow --exclude .git | fzf --preview 'bat --color=always --style=numbers --line-range=:500 {}')
    if [[ -n "$file" ]]; then
        ${EDITOR:-nvim} "$file"
    fi
}

# fzf git log - interactive git log browser
function fgl() {
    git log --oneline --graph --color=always --decorate |
        fzf --ansi --no-sort --reverse --preview 'echo {} | grep -o "[a-f0-9]\{7,\}" | head -1 | xargs git show --color=always' |
        grep -o "[a-f0-9]\{7,\}" | head -1 | pbcopy
    echo "Commit hash copied to clipboard"
}

# fzf branch checkout
function fbr() {
    local branches branch
    branches=$(git branch --all --sort=-committerdate | grep -v HEAD)
    branch=$(echo "$branches" | fzf --preview 'git log --oneline --graph --color=always --date=short {1}' | sed "s/.* //" | sed "s#remotes/[^/]*/##")
    if [[ -n "$branch" ]]; then
        git checkout "$branch"
    fi
}

# fzf process kill
function fkill() {
    local pid
    pid=$(ps -ef | sed 1d | fzf -m --header='[kill process]' | awk '{print $2}')
    if [[ -n "$pid" ]]; then
        echo "$pid" | xargs kill -${1:-9}
    fi
}

# ──────────────────────────────────────────────────────────────
# Obsidian helpers
# ──────────────────────────────────────────────────────────────

# Quick note capture to Obsidian inbox
function note() {
    local vault="${OBSIDIAN_VAULT:-$HOME/Documents/Obsidian}"
    local inbox_dir="${vault}/Inbox"
    mkdir -p "$inbox_dir"

    if [ $# -eq 0 ]; then
        # No args: open new note in editor
        local file="${inbox_dir}/$(date +%Y%m%d%H%M%S).md"
        ${EDITOR:-nvim} "$file"
    else
        # Args provided: quick capture
        local file="${inbox_dir}/$(date +%Y%m%d%H%M%S).md"
        echo "# $(date '+%Y-%m-%d %H:%M')" > "$file"
        echo "" >> "$file"
        echo "$*" >> "$file"
        echo "Note saved: $file"
    fi
}

# Daily note
function daily() {
    local vault="${OBSIDIAN_VAULT:-$HOME/Documents/Obsidian}"
    local daily_dir="${vault}/Daily"
    mkdir -p "$daily_dir"

    local file="${daily_dir}/$(date +%Y-%m-%d).md"
    if [ ! -f "$file" ]; then
        cat > "$file" << EOF
# $(date '+%A, %B %d, %Y')

## Tasks
- [ ]

## Notes

## Journal

EOF
    fi
    ${EDITOR:-nvim} "$file"
}

# Search Obsidian vault with fzf + preview
function obs() {
    local vault="${OBSIDIAN_VAULT:-$HOME/Documents/Obsidian}"
    local file
    file=$(rg --files "$vault" --glob '*.md' 2>/dev/null | \
        fzf --preview 'bat --color=always --style=plain {}' \
            --header 'Search Obsidian vault')
    if [[ -n "$file" ]]; then
        ${EDITOR:-nvim} "$file"
    fi
}

# Full-text search in Obsidian vault
function obsg() {
    local vault="${OBSIDIAN_VAULT:-$HOME/Documents/Obsidian}"
    local query="${1:-}"
    if [ -z "$query" ]; then
        echo "Usage: obsg <search_term>"
        return 1
    fi
    rg --color=always "$query" "$vault" --glob '*.md' -l | \
        fzf --preview "rg --color=always --context 3 '$query' {}" \
            --header "Obsidian search: $query" | \
        xargs -r ${EDITOR:-nvim}
}

# ──────────────────────────────────────────────────────────────
# macOS specific
# ──────────────────────────────────────────────────────────────

# Change working directory to the top-most Finder window location
function cdf() {
    cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')" 2>/dev/null
}

# Open current directory or file in VSCode
function c() {
    if [ $# -eq 0 ]; then
        code .
    else
        code "$@"
    fi
}

# Open current directory in Finder
function o() {
    if [ $# -eq 0 ]; then
        open .
    else
        open "$@"
    fi
}
